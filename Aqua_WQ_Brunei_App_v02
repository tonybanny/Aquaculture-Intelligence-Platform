      Severity = character(0),
      Message = character(0),
      Time_Detected = character(0),
      stringsAsFactors = FALSE
    )
    
    # BULLETPROOF parameter extraction with comprehensive error handling
    extract_station_parameter <- function(station_df, parameter_name, station_name, default_value = 0) {
      tryCatch({
        # Multiple validation layers
        if(is.null(station_df) || nrow(station_df) == 0) {
          return(default_value)
        }
        
        if(is.null(parameter_name) || is.na(parameter_name) || parameter_name == "") {
          return(default_value)
        }
        
        if(is.null(station_name) || is.na(station_name) || station_name == "") {
          return(default_value)
        }
        
        if(!station_name %in% colnames(station_df)) {
          return(default_value)
        }
        
        # Extract value with multiple fallbacks
        val <- station_df %>% 
          filter(parameter == parameter_name) %>% 
          pull(!!sym(station_name))
        
        # Comprehensive length and validity checks
        if(length(val) == 0) {
          return(default_value)
        }
        
        if(all(is.na(val))) {
          return(default_value)
        }
        
        # Take first non-NA value
        val_clean <- val[!is.na(val)]
        if(length(val_clean) == 0) {
          return(default_value)
        }
        
        # Convert to numeric with validation
        val_numeric <- tryCatch({
          as.numeric(val_clean[1])
        }, warning = function(w) default_value, error = function(e) default_value)
        
        # Final validation
        if(length(val_numeric) == 0 || is.na(val_numeric) || !is.finite(val_numeric)) {
          return(default_value)
        }
        
        return(val_numeric)
        
      }, error = function(e) {
        message("Parameter extraction error for ", parameter_name, " at ", station_name, ": ", e$message)
        return(default_value)
      })
    }
    
    # Get current values using bulletproof extraction
    temp <- extract_station_parameter(station_df, "Temperature (Deg C)", current_station, 28)
    ph <- extract_station_parameter(station_df, "pH", current_station, 7.5)
    do_val <- extract_station_parameter(station_df, "DO (mg/l)", current_station, 6)
    ammonia <- extract_station_parameter(station_df, "Total Ammonia (NH3) (mg/l)", current_station, 0.1)
    
    # FIXED: Helper function to add alerts with PROPER VECTOR STRUCTURE
    add_alert_safe <- function(alerts_df, type, severity, message, time) {
      # CRITICAL: Ensure all inputs are proper scalar character vectors
      type <- as.character(type)[1]
      severity <- as.character(severity)[1]
      message <- as.character(message)[1]
      time <- as.character(time)[1]
      
      # Create new row with exact same column structure
      new_row <- data.frame(
        Alert_Type = type,
        Severity = severity,
        Message = message,
        Time_Detected = time,
        stringsAsFactors = FALSE
      )
      
      # FIXED: Use proper rbind with matching column structures
      tryCatch({
        return(rbind(alerts_df, new_row))
      }, error = function(e) {
        # If rbind fails, create new dataframe
        return(data.frame(
          Alert_Type = c(alerts_df$Alert_Type, type),
          Severity = c(alerts_df$Severity, severity),
          Message = c(alerts_df$Message, message),
          Time_Detected = c(alerts_df$Time_Detected, time),
          stringsAsFactors = FALSE
        ))
      })
    }
    
    # BULLETPROOF alert generation - check each condition safely
    tryCatch({
      # Dissolved oxygen check
      if(length(do_val) > 0 && !is.na(do_val) && is.finite(do_val) && do_val < 4) {
        alerts <- add_alert_safe(
          alerts,
          "Low Dissolved Oxygen",
          "Critical",
          paste0("DO level at ", round(do_val, 2), " mg/L - Fish mortality risk"),
          format(Sys.time(), "%H:%M:%S")
        )
      }
      
      # Temperature check
      if(length(temp) > 0 && !is.na(temp) && is.finite(temp) && (temp > 32 || temp < 24)) {
        alerts <- add_alert_safe(
          alerts,
          "Temperature Alert",
          ifelse(temp > 35 || temp < 20, "Critical", "High"),
          paste0("Temperature at ", round(temp, 1), "°C - Outside optimal range"),
          format(Sys.time() - 300, "%H:%M:%S")
        )
      }
      
      # pH check
      if(length(ph) > 0 && !is.na(ph) && is.finite(ph) && (ph > 8.5 || ph < 6.5)) {
        alerts <- add_alert_safe(
          alerts,
          "pH Imbalance",
          ifelse(ph > 9 || ph < 6, "Critical", "High"),
          paste0("pH level at ", round(ph, 2), " - Requires immediate attention"),
          format(Sys.time() - 150, "%H:%M:%S")
        )
      }
      
      # FIXED: Ammonia check - This was the original error source
      if(length(ammonia) > 0 && !is.na(ammonia) && is.finite(ammonia) && ammonia > 0.05) {
        alerts <- add_alert_safe(
          alerts,
          "High Ammonia",
          ifelse(ammonia > 0.1, "Critical", "Medium"),
          paste0("Ammonia at ", round(ammonia, 3), " mg/L - Toxic to fish"),
          format(Sys.time() - 450, "%H:%M:%S")
        )
      }
      
    }, error = function(e) {
      # If any alert generation fails, create error alert
      alerts <- add_alert_safe(
        alerts,
        "System Error",
        "Warning",
        paste0("Alert generation error: ", substr(e$message, 1, 50)),
        format(Sys.time(), "%H:%M:%S")
      )
    })
    
    # Add normal status if no alerts were generated
    if(nrow(alerts) == 0) {
      alerts <- add_alert_safe(
        alerts,
        "System Normal",
        "Info",
        "All parameters within acceptable ranges",
        format(Sys.time(), "%H:%M:%S")
      )
    }
    
    # CRITICAL FIX: Ensure all columns are proper character vectors before datatable
    alerts$Alert_Type <- as.character(alerts$Alert_Type)
    alerts$Severity <- as.character(alerts$Severity) 
    alerts$Message <- as.character(alerts$Message)
    alerts$Time_Detected <- as.character(alerts$Time_Detected)
    
    # Remove any potential factor levels that could cause rep_len issues
    alerts <- data.frame(lapply(alerts, as.character), stringsAsFactors = FALSE)
    
    # FIXED: Create column names that work with DT (no special characters)
    colnames(alerts) <- c("Alert Type", "Severity", "Message", "Time Detected")
    
