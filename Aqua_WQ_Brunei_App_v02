  # Time series forecasting function
  forecast_water_quality <- function(historical_data, horizon = 30, frequency = 7) {
    forecasts <- list()
    
    for(param in c("temperature", "pH", "dissolved_oxygen", "ammonia")) {
      if(param %in% colnames(historical_data)) {
        ts_data <- ts(historical_data[[param]], frequency = frequency)
        
        # Auto ARIMA forecasting
        model <- forecast::auto.arima(ts_data, seasonal = TRUE)
        forecast_result <- forecast::forecast(model, h = horizon)
        
        forecasts[[param]] <- list(
          forecast = as.numeric(forecast_result$mean),
          lower_80 = as.numeric(forecast_result$lower[,1]),
          upper_80 = as.numeric(forecast_result$upper[,1]),
          lower_95 = as.numeric(forecast_result$lower[,2]),
          upper_95 = as.numeric(forecast_result$upper[,2])
        )
      }
    }
    
    return(forecasts)
  }
  
  
  
