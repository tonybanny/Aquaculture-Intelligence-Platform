  preview_se_data <- function(df, mapping) {
    if(nrow(df) == 0) return(NULL)
    
    preview_info <- list(
      total_rows = nrow(df),
      detected_columns = mapping,
      sample_data = head(df, 3),
      column_types = sapply(df, class),
      missing_data = sapply(df, function(x) sum(is.na(x))),
      data_quality_score = calculate_data_quality_score(df, mapping)
    )
    
    return(preview_info)
  }
  
  # Data quality scoring
  calculate_data_quality_score <- function(df, mapping) {
    if(nrow(df) == 0) return(0)
    
    score <- 0
    max_score <- 4
    
    # Check for essential columns
    if("station" %in% names(mapping)) score <- score + 1
    if("production_tonnes" %in% names(mapping)) score <- score + 1
    if("price_per_tonne" %in% names(mapping)) score <- score + 1
    if("year" %in% names(mapping)) score <- score + 1
    
    # Penalize for missing data
    missing_penalty <- mean(sapply(df, function(x) sum(is.na(x)) / length(x)))
    score <- score * (1 - missing_penalty * 0.5)
    
    return(round((score / max_score) * 100, 1))
  }
  
