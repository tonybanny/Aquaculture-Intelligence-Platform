  # Real-time alert system
  generate_alerts <- function(current_conditions, thresholds = list()) {
    alerts <- list()
    
    # Default thresholds
    default_thresholds <- list(
      temperature = list(min = 24, max = 32),
      pH = list(min = 6.5, max = 8.5),
      dissolved_oxygen = list(min = 5, max = 12),
      ammonia = list(min = 0, max = 0.05)
    )
    
    thresholds <- modifyList(default_thresholds, thresholds)
    
    for(param in names(current_conditions)) {
      if(param %in% names(thresholds)) {
        value <- current_conditions[[param]]
        threshold <- thresholds[[param]]
        
        if(value < threshold$min) {
          alerts[[paste0(param, "_low")]] <- list(
            severity = "high",
            message = paste(param, "is below optimal range:", value, "<", threshold$min),
            recommendation = paste("Increase", param, "to optimal range")
          )
        } else if(value > threshold$max) {
          alerts[[paste0(param, "_high")]] <- list(
            severity = "high", 
            message = paste(param, "is above optimal range:", value, ">", threshold$max),
            recommendation = paste("Reduce", param, "to optimal range")
          )
        }
      }
    }
    
    return(alerts)
  }
  
  
