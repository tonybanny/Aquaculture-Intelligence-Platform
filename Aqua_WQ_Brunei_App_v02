  # Optimized training data generation with more realistic patterns
  generate_enhanced_training_data <- function(n_samples = 2000) {
    set.seed(42)
    
    # Generate realistic water quality patterns
    data.frame(
      temperature = rnorm(n_samples, 28, 3),
      pH = rnorm(n_samples, 7.5, 0.5),
      dissolved_oxygen = abs(rnorm(n_samples, 6, 1.5)),
      ammonia = abs(rnorm(n_samples, 0.05, 0.03)),
      nitrate = abs(rnorm(n_samples, 2, 1)),
      phosphate = abs(rnorm(n_samples, 0.3, 0.2)),
      turbidity = abs(rnorm(n_samples, 12, 5)),
      alkalinity = rnorm(n_samples, 100, 20),
      culture_type = sample(c("Tilapia", "Shrimp", "Seabass", "Carp"), n_samples, replace = TRUE),
      stocking_density = runif(n_samples, 50, 150),
      feed_quality = runif(n_samples, 0.7, 1.0),
      season = sample(c("Dry", "Wet"), n_samples, replace = TRUE)
    ) %>%
      mutate(
        # Calculate stress indices
        temp_stress = pmax(0, pmin(1, abs(temperature - 28) / 10)),
        ph_stress = pmax(0, pmin(1, abs(pH - 7.5) / 2)),
        do_stress = pmax(0, pmin(1, (5 - dissolved_oxygen) / 5)),
        ammonia_stress = pmax(0, pmin(1, ammonia / 0.1)),
        combined_stress = (temp_stress + ph_stress + do_stress + ammonia_stress) / 4,
        
        # Calculate realistic outcomes with noise
        productivity = 100 * (1 - combined_stress * 0.7) * 
          (feed_quality * 0.8 + 0.2) *
          ifelse(season == "Dry", 1.1, 0.9) +
          rnorm(n_samples, 0, 5),
        
        mortality = 0.02 * (1 + combined_stress * 5) * 
          ifelse(season == "Wet", 1.2, 0.8) +
          abs(rnorm(n_samples, 0, 0.005)),
        
        morbidity = 0.05 * (1 + combined_stress * 3) * 
          ifelse(season == "Wet", 1.3, 0.9) +
          abs(rnorm(n_samples, 0, 0.01)),
        
        economic_loss = mortality * productivity * 50 + morbidity * productivity * 20
      ) %>%
      mutate(
        productivity = pmax(10, pmin(200, productivity)),
        mortality = pmax(0.001, pmin(0.3, mortality)),
        morbidity = pmax(0.005, pmin(0.5, morbidity))
      )
  }
  
