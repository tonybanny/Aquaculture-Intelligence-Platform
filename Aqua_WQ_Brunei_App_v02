  # FIXED: Smart Alerts Table with GUARANTEED alerts object initialization
  output$smart_alerts_table <- DT::renderDataTable({
    req(input$selected_station_ml)
    
    current_station <- input$selected_station_ml
    
    # CRITICAL FIX: Initialize alerts dataframe IMMEDIATELY at function start
    alerts <- data.frame(
      `Alert Type` = character(0),
      Severity = character(0),
      Message = character(0),
      `Time Detected` = character(0),
      stringsAsFactors = FALSE,
      check.names = FALSE
    )
    
    # BULLETPROOF approach - wrap entire function in tryCatch
    tryCatch({
      # Validate station selection
      if(is.null(current_station) || length(current_station) == 0 || 
         is.na(current_station) || current_station == "" ||
         !current_station %in% colnames(station_df)) {
        
        # FIXED: Properly add to existing alerts object
        alerts <- rbind(alerts, data.frame(
          `Alert Type` = "Station Error",
          Severity = "Warning", 
          Message = "Invalid station selection",
          `Time Detected` = format(Sys.time(), "%H:%M:%S"),
          stringsAsFactors = FALSE,
          check.names = FALSE
        ))
      } else {
        # Parameter extraction with comprehensive validation
        extract_param_safe <- function(param_name, default_val) {
          tryCatch({
            val <- station_df %>% 
              filter(parameter == param_name) %>% 
              pull(!!sym(current_station))
            
            if(length(val) == 0 || all(is.na(val))) {
              return(default_val)
            }
            
            val_clean <- val[!is.na(val)]
            if(length(val_clean) == 0) {
              return(default_val)
            }
            
            val_numeric <- as.numeric(val_clean[1])
            
            if(is.na(val_numeric) || !is.finite(val_numeric)) {
              return(default_val)
            }
            
            return(val_numeric)
          }, error = function(e) default_val)
        }
        
        # Extract parameters with defaults
        temp <- extract_param_safe("Temperature (Deg C)", 28)
        ph <- extract_param_safe("pH", 7.5)
        do_val <- extract_param_safe("DO (mg/l)", 6)
        ammonia <- extract_param_safe("Total Ammonia (NH3) (mg/l)", 0.05)
        
        # Generate alerts with bulletproof error handling
        # Check dissolved oxygen
        if(length(do_val) > 0 && is.numeric(do_val) && !is.na(do_val) && is.finite(do_val) && do_val < 4) {
          alerts <- rbind(alerts, data.frame(
            `Alert Type` = "Low Dissolved Oxygen",
            Severity = "Critical",
            Message = paste0("DO level at ", round(do_val, 2), " mg/L - Fish mortality risk"),
            `Time Detected` = format(Sys.time(), "%H:%M:%S"),
            stringsAsFactors = FALSE,
            check.names = FALSE
          ))
        }
        
        # Check temperature
        if(length(temp) > 0 && is.numeric(temp) && !is.na(temp) && is.finite(temp) && (temp > 32 || temp < 24)) {
          alerts <- rbind(alerts, data.frame(
            `Alert Type` = "Temperature Alert",
            Severity = ifelse(temp > 35 || temp < 20, "Critical", "High"),
            Message = paste0("Temperature at ", round(temp, 1), "°C - Outside optimal range"),
            `Time Detected` = format(Sys.time() - 300, "%H:%M:%S"),
            stringsAsFactors = FALSE,
            check.names = FALSE
          ))
        }
        
        # Check pH
        if(length(ph) > 0 && is.numeric(ph) && !is.na(ph) && is.finite(ph) && (ph > 8.5 || ph < 6.5)) {
          alerts <- rbind(alerts, data.frame(
            `Alert Type` = "pH Imbalance",
            Severity = ifelse(ph > 9 || ph < 6, "Critical", "High"),
            Message = paste0("pH level at ", round(ph, 2), " - Requires immediate attention"),
            `Time Detected` = format(Sys.time() - 150, "%H:%M:%S"),
            stringsAsFactors = FALSE,
            check.names = FALSE
          ))
        }
        
        # FIXED: Check ammonia - this was the original error source
        if(length(ammonia) > 0 && is.numeric(ammonia) && !is.na(ammonia) && is.finite(ammonia) && ammonia > 0.05) {
          alerts <- rbind(alerts, data.frame(
            `Alert Type` = "High Ammonia",
            Severity = ifelse(ammonia > 0.1, "Critical", "Medium"),
            Message = paste0("Ammonia at ", round(ammonia, 3), " mg/L - Toxic to fish"),
            `Time Detected` = format(Sys.time() - 450, "%H:%M:%S"),
            stringsAsFactors = FALSE,
            check.names = FALSE
          ))
        }
      }
      
      # Add normal status if no alerts were generated
      if(nrow(alerts) == 0) {
        alerts <- rbind(alerts, data.frame(
          `Alert Type` = "System Normal",
          Severity = "Info",
          Message = "All parameters within acceptable ranges",
          `Time Detected` = format(Sys.time(), "%H:%M:%S"),
          stringsAsFactors = FALSE,
          check.names = FALSE
        ))
      }
      
      # FIXED: Return formatted datatable with comprehensive error handling
      return(tryCatch({
        datatable(
          alerts,
          options = list(
            pageLength = 5, 
            dom = 't', 
            scrollX = TRUE,
            columnDefs = list(
