  ord_data <- reactive({
    req(station_df)
    
    # Prepare matrix for ordination - Fix the column selection
    mat <- station_df %>%
      tibble::column_to_rownames("parameter") %>%
      dplyr::select(-index) %>%  # Use explicit dplyr::select
      as.matrix() %>%
      t()  # Transpose so stations are rows, parameters are columns
    
    # Remove columns with all NA or zero variance
    mat_clean <- mat[, apply(mat, 2, function(x) !all(is.na(x)) && var(x, na.rm = TRUE) > 0), drop = FALSE]
    
    # Replace remaining NAs with parameter means
    for(i in 1:ncol(mat_clean)) {
      mat_clean[is.na(mat_clean[,i]), i] <- mean(mat_clean[,i], na.rm = TRUE)
    }
    
    # Add station metadata
    station_scores <- compute_scores()
    station_metadata <- data.frame(
      station = rownames(mat_clean),
      quality_score = station_scores$score_pct[match(rownames(mat_clean), station_scores$station)],
      station_type = case_when(
        grepl("haz", rownames(mat_clean)) ~ "Haz Sites",
        grepl("hel", rownames(mat_clean)) ~ "Hel Sites", 
        grepl("mr", rownames(mat_clean)) ~ "MR Sites",
        grepl("ps", rownames(mat_clean)) ~ "PS Sites",
        TRUE ~ "Other"
      ),
      performance = case_when(
        station_scores$score_pct[match(rownames(mat_clean), station_scores$station)] >= 80 ~ "Excellent",
        station_scores$score_pct[match(rownames(mat_clean), station_scores$station)] >= 60 ~ "Good",
        station_scores$score_pct[match(rownames(mat_clean), station_scores$station)] >= 40 ~ "Fair",
        station_scores$score_pct[match(rownames(mat_clean), station_scores$station)] >= 20 ~ "Poor",
        TRUE ~ "Critical"
      )
    )
    
    # Fixed constraint matrix preparation
    constraint_mat <- long_df %>%
      dplyr::left_join(optimal_ranges, by = "parameter") %>%
      dplyr::filter(!is.na(value)) %>%
      dplyr::mutate(
        deviation = case_when(
          !is.na(min) & !is.na(max) ~ abs((value - (min + max)/2) / ((max - min)/2)),
          !is.na(min) & is.na(max) ~ pmax(0, (min - value) / pmax(min, 1)),
          is.na(min) & !is.na(max) ~ pmax(0, (value - max) / pmax(max, 1)),
          TRUE ~ 0
        )
      ) %>%
      dplyr::select(station, parameter, deviation) %>%
      tidyr::pivot_wider(names_from = parameter, values_from = deviation, values_fill = 0) %>%
      tibble::column_to_rownames("station") %>%
      as.matrix()
    
    # Match constraint matrix to cleaned data
    common_stations <- intersect(rownames(mat_clean), rownames(constraint_mat))
    common_parameters <- intersect(colnames(mat_clean), colnames(constraint_mat))
    
    if(length(common_stations) > 0 && length(common_parameters) > 0) {
      mat_clean <- mat_clean[common_stations, common_parameters, drop = FALSE]
      constraint_mat <- constraint_mat[common_stations, common_parameters, drop = FALSE]
      
      # Update station metadata to match
      station_metadata <- station_metadata[station_metadata$station %in% common_stations, ]
    }
    
    list(
      data_matrix = mat_clean,
      station_metadata = station_metadata,
      constraint_matrix = constraint_mat
    )
  })
  
  
  # Perform ordination analysis
  perform_ordination <- reactive({
    req(input$ord_method)
    data_list <- ord_data()
    
    result <- switch(input$ord_method,
                     "pca" = {
                       ord_result <- rda(data_list$data_matrix, scale = TRUE)
                       list(
                         ordination = ord_result,
                         method = "PCA",
                         constrained = FALSE,
                         type = "linear"
                       )
                     },
                     "rda" = {
                       # Use constraint matrix as environmental variables
                       env_summary <- rowSums(data_list$constraint_matrix)  # Total deviation score
                       ord_result <- rda(data_list$data_matrix ~ env_summary, scale = TRUE)
                       list(
                         ordination = ord_result,
                         method = "RDA",
                         constrained = TRUE,
                         constraint_var = env_summary,
                         type = "linear"
                       )
                     },
                     "cca" = {
                       env_summary <- rowSums(data_list$constraint_matrix)
                       ord_result <- cca(data_list$data_matrix ~ env_summary)
                       list(
                         ordination = ord_result,
                         method = "CCA", 
                         constrained = TRUE,
                         constraint_var = env_summary,
                         type = "unimodal"
                       )
                     }
    )
    
    result
  })
  
  
