server <- function(input, output, session) {
  # Reactive long-form data
  long_df_r <- reactive({
    to_long(station_df)
  })
  
  observeEvent(input$enter_app, {
    showModal(modalDialog(
      title = div(
        style = "text-align: center; color: #00d9ff; font-size: 2rem;",
        "🎯 Welcome to AQUA_BRU"
      ),
      div(
        style = "text-align: center; padding: 2rem;",
        h4("Your water quality intelligence system is ready!"),
        br(),
        p(style = "color: #a0aec0;",
          "This elegant homepage will be integrated with your existing dashboard.",
          br(), br(),
          "Click 'Continue' to return to the full application."
        )
      ),
      footer = tagList(
        modalButton("Continue"),
        actionButton("restart", "Restart Animation", 
                     class = "btn-primary")
      ),
      size = "m",
      easyClose = TRUE
    ))
  })
  
  observeEvent(input$restart, {
    removeModal()
  })
  
  
  # 6. SERVER: DATA IMPORT LOGIC
  observeEvent(input$user_data_upload, {
    req(input$user_data_upload)
    
    tryCatch({
      # Read file based on extension and separator
      file_ext <- tools::file_ext(input$user_data_upload$name)
      
      uploaded_df <- switch(
        tolower(file_ext),
        "csv" = {
          sep <- if(input$file_separator == "auto") {
            # Auto-detect separator
            sample <- readLines(input$user_data_upload$datapath, n = 5)
            if(sum(grepl(";", sample)) > sum(grepl(",", sample))) ";" else ","
          } else {
            input$file_separator
          }
          
          read.csv(
            input$user_data_upload$datapath,
            sep = sep,
            header = input$file_has_header,
            stringsAsFactors = FALSE,
            check.names = FALSE
          )
        },
        "xlsx" = openxlsx::read.xlsx(input$user_data_upload$datapath, sheet = 1),
        "xls" = openxlsx::read.xlsx(input$user_data_upload$datapath, sheet = 1),
        "txt" = read.table(
          input$user_data_upload$datapath,
          sep = if(input$file_separator == "auto") "\t" else input$file_separator,
          header = input$file_has_header,
          stringsAsFactors = FALSE,
          check.names = FALSE
        ),
        "tsv" = read.table(
          input$user_data_upload$datapath,
          sep = "\t",
          header = input$file_has_header,
          stringsAsFactors = FALSE,
          check.names = FALSE
        ),
        stop("Unsupported file format")
      )
      
      # Store uploaded data
      user_data(uploaded_df)
      
      # Detect column mapping
      detected_mapping <- detect_column_types(uploaded_df)
      column_mapping(detected_mapping)
      
      # Detect data format
      format_info <- detect_data_format(uploaded_df)
      
      showNotification(
        paste0("✅ File uploaded successfully! ",
               "Detected ", format_info$format, " format with ",
               format_info$n_rows, " rows and ", format_info$n_cols, " columns."),
        type = "message",
        duration = 5
      )
      
    }, error = function(e) {
      showNotification(
        paste("❌ Upload failed:", e$message),
        type = "error",
        duration = 10
      )
    })
  }) 
  
  
  # current thresholds (reactive)
  thresholds <- reactiveVal({
    # start with Tilapia preset
    species_thresholds[["Tilapia"]]
  })
  
  # Apply species preset
  observeEvent(input$apply_preset, {
    sel <- input$species_select
    if (!is.null(sel) && sel %in% names(species_thresholds)) {
      thresholds(species_thresholds[[sel]])
      showNotification(paste("Applied thresholds for", sel), type="message")
    }
  })
  
  # Update weights from sliders
  weights_r <- reactive({
    w <- default_weights
    w["DO (mg/l)"] <- input$do_weight
    w["Total Ammonia (NH3) (mg/l)"] <- input$nh3_weight
    w["BOD (mg/l)"] <- input$bod_weight
    w
  })
  
  # Compare with current thresholds
  compare_r <- reactive({
    thr <- thresholds()
    long <- long_df_r()
    compare_with_thresholds(long, thr)
  })
  
  # Weighted scoring
  score_r <- reactive({
    comp <- compare_r()
    compute_weighted_score(comp, weights_r())
  })
  
  
  # Helper: safe parameter extraction from station_df
  safe_extract_param <- function(station_df, station_name, param_name, default = NA_real_) {
    if(is.null(station_name) || !nzchar(station_name) || !(station_name %in% colnames(station_df))) {
      return(default)
    }
    # If station_df has rows keyed by 'parameter'
    if("parameter" %in% colnames(station_df)) {
      val <- station_df %>% filter(.data$parameter == !!param_name) %>% pull(!!sym(station_name))
      if(length(val) == 0 || all(is.na(val))) return(default)
      v <- suppressWarnings(as.numeric(val[1]))
      if(is.na(v) || !is.finite(v)) return(default)
      return(v)
    } else {
      # fallback: try to find param_name as a column
      if(param_name %in% colnames(station_df)) {
        val <- station_df[[param_name]]
        v <- suppressWarnings(as.numeric(val[1]))
        if(is.na(v) || !is.finite(v)) return(default)
        return(v)
      }
      return(default)
    }
  }
  
  # Alert generator (pure function)
  alerts <- function(temp, ph, do_val, ammonia) {
    alerts <- data.frame(
      `Alert Type` = character(0),
      Severity = character(0),
      Message = character(0),
      `Time Detected` = character(0),
      stringsAsFactors = FALSE,
      check.names = FALSE
    )
    
    # DO
    if(!is.na(do_val) && do_val < 4) {
      alerts <- rbind(alerts, data.frame(
        `Alert Type` = "Low Dissolved Oxygen",
        Severity = "Critical",
        Message = paste0("DO level at ", round(do_val, 2), " mg/L - Fish mortality risk"),
        `Time Detected` = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
        stringsAsFactors = FALSE,
        check.names = FALSE
      ))
    }
    
    # Temperature
    if(!is.na(temp) && (temp > 32 || temp < 24)) {
      alerts <- rbind(alerts, data.frame(
        `Alert Type` = "Temperature Alert",
        Severity = ifelse(temp > 35 || temp < 20, "Critical", "High"),
        Message = paste0("Temperature at ", round(temp, 1), " °C - Outside optimal range"),
        `Time Detected` = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
        stringsAsFactors = FALSE,
        check.names = FALSE
      ))
    }
    
    # pH
    if(!is.na(ph) && (ph > 8.5 || ph < 6.5)) {
      alerts <- rbind(alerts, data.frame(
        `Alert Type` = "pH Imbalance",
        Severity = ifelse(ph > 9 || ph < 6, "Critical", "High"),
        Message = paste0("pH level at ", round(ph, 2), " - Requires attention"),
        `Time Detected` = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
        stringsAsFactors = FALSE,
        check.names = FALSE
      ))
    }
    
    # Ammonia
    if(!is.na(ammonia) && ammonia > 0.05) {
      alerts <- rbind(alerts, data.frame(
        `Alert Type` = "High Ammonia",
        Severity = ifelse(ammonia > 0.1, "Critical", "Medium"),
        Message = paste0("Ammonia at ", round(ammonia, 3), " mg/L - Toxic to fish"),
        `Time Detected` = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
        stringsAsFactors = FALSE,
        check.names = FALSE
      ))
    }
    
    # If no alerts, return normal status
    if(nrow(alerts) == 0) {
      alerts <- data.frame(
        `Alert Type` = "System Normal",
        Severity = "Info",
        Message = "All parameters within acceptable ranges",
        `Time Detected` = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
        stringsAsFactors = FALSE,
        check.names = FALSE
      )
    }
    
    return(alerts)
  }
  
  
  
  # FIXED: Smart Alerts Table with GUARANTEED proper data structure
  output$smart_alerts_table <- DT::renderDataTable({
    req(input$selected_station_ml)
    
    current_station <- input$selected_station_ml
    
    # CRITICAL FIX: Initialize alerts dataframe with PROPER VECTOR COLUMNS
    alerts <- data.frame(
      Alert_Type = character(0),
      Severity = character(0),
      Message = character(0),
      Time_Detected = character(0),
      stringsAsFactors = FALSE
    )
    
    # BULLETPROOF parameter extraction with comprehensive error handling
    extract_station_parameter <- function(station_df, parameter_name, station_name, default_value = 0) {
      tryCatch({
        # Multiple validation layers
        if(is.null(station_df) || nrow(station_df) == 0) {
          return(default_value)
        }
        
        if(is.null(parameter_name) || is.na(parameter_name) || parameter_name == "") {
          return(default_value)
        }
        
        if(is.null(station_name) || is.na(station_name) || station_name == "") {
          return(default_value)
        }
        
        if(!station_name %in% colnames(station_df)) {
          return(default_value)
        }
        
        # Extract value with multiple fallbacks
        val <- station_df %>% 
          filter(parameter == parameter_name) %>% 
          pull(!!sym(station_name))
        
        # Comprehensive length and validity checks
        if(length(val) == 0) {
          return(default_value)
        }
        
        if(all(is.na(val))) {
          return(default_value)
        }
        
        # Take first non-NA value
        val_clean <- val[!is.na(val)]
        if(length(val_clean) == 0) {
          return(default_value)
        }
        
        # Convert to numeric with validation
        val_numeric <- tryCatch({
          as.numeric(val_clean[1])
        }, warning = function(w) default_value, error = function(e) default_value)
        
        # Final validation
        if(length(val_numeric) == 0 || is.na(val_numeric) || !is.finite(val_numeric)) {
          return(default_value)
        }
        
        return(val_numeric)
        
      }, error = function(e) {
        message("Parameter extraction error for ", parameter_name, " at ", station_name, ": ", e$message)
        return(default_value)
      })
    }
    
    # Get current values using bulletproof extraction
    temp <- extract_station_parameter(station_df, "Temperature (Deg C)", current_station, 28)
    ph <- extract_station_parameter(station_df, "pH", current_station, 7.5)
    do_val <- extract_station_parameter(station_df, "DO (mg/l)", current_station, 6)
    ammonia <- extract_station_parameter(station_df, "Total Ammonia (NH3) (mg/l)", current_station, 0.1)
    
    # FIXED: Helper function to add alerts with PROPER VECTOR STRUCTURE
    add_alert_safe <- function(alerts_df, type, severity, message, time) {
      # CRITICAL: Ensure all inputs are proper scalar character vectors
      type <- as.character(type)[1]
      severity <- as.character(severity)[1]
      message <- as.character(message)[1]
      time <- as.character(time)[1]
      
      # Create new row with exact same column structure
      new_row <- data.frame(
        Alert_Type = type,
        Severity = severity,
        Message = message,
        Time_Detected = time,
        stringsAsFactors = FALSE
      )
      
      # FIXED: Use proper rbind with matching column structures
      tryCatch({
        return(rbind(alerts_df, new_row))
      }, error = function(e) {
        # If rbind fails, create new dataframe
        return(data.frame(
          Alert_Type = c(alerts_df$Alert_Type, type),
          Severity = c(alerts_df$Severity, severity),
          Message = c(alerts_df$Message, message),
          Time_Detected = c(alerts_df$Time_Detected, time),
          stringsAsFactors = FALSE
        ))
      })
    }
    
    # BULLETPROOF alert generation - check each condition safely
    tryCatch({
      # Dissolved oxygen check
      if(length(do_val) > 0 && !is.na(do_val) && is.finite(do_val) && do_val < 4) {
        alerts <- add_alert_safe(
          alerts,
          "Low Dissolved Oxygen",
          "Critical",
          paste0("DO level at ", round(do_val, 2), " mg/L - Fish mortality risk"),
          format(Sys.time(), "%H:%M:%S")
        )
      }
      
      # Temperature check
      if(length(temp) > 0 && !is.na(temp) && is.finite(temp) && (temp > 32 || temp < 24)) {
        alerts <- add_alert_safe(
          alerts,
          "Temperature Alert",
          ifelse(temp > 35 || temp < 20, "Critical", "High"),
          paste0("Temperature at ", round(temp, 1), "°C - Outside optimal range"),
          format(Sys.time() - 300, "%H:%M:%S")
        )
      }
      
      # pH check
      if(length(ph) > 0 && !is.na(ph) && is.finite(ph) && (ph > 8.5 || ph < 6.5)) {
        alerts <- add_alert_safe(
          alerts,
          "pH Imbalance",
          ifelse(ph > 9 || ph < 6, "Critical", "High"),
          paste0("pH level at ", round(ph, 2), " - Requires immediate attention"),
          format(Sys.time() - 150, "%H:%M:%S")
        )
      }
      
      # FIXED: Ammonia check - This was the original error source
      if(length(ammonia) > 0 && !is.na(ammonia) && is.finite(ammonia) && ammonia > 0.05) {
        alerts <- add_alert_safe(
          alerts,
          "High Ammonia",
          ifelse(ammonia > 0.1, "Critical", "Medium"),
          paste0("Ammonia at ", round(ammonia, 3), " mg/L - Toxic to fish"),
          format(Sys.time() - 450, "%H:%M:%S")
        )
      }
      
    }, error = function(e) {
      # If any alert generation fails, create error alert
      alerts <- add_alert_safe(
        alerts,
        "System Error",
        "Warning",
        paste0("Alert generation error: ", substr(e$message, 1, 50)),
        format(Sys.time(), "%H:%M:%S")
      )
    })
    
    # Add normal status if no alerts were generated
    if(nrow(alerts) == 0) {
      alerts <- add_alert_safe(
        alerts,
        "System Normal",
        "Info",
        "All parameters within acceptable ranges",
        format(Sys.time(), "%H:%M:%S")
      )
    }
    
    # CRITICAL FIX: Ensure all columns are proper character vectors before datatable
    alerts$Alert_Type <- as.character(alerts$Alert_Type)
    alerts$Severity <- as.character(alerts$Severity) 
    alerts$Message <- as.character(alerts$Message)
    alerts$Time_Detected <- as.character(alerts$Time_Detected)
    
    # Remove any potential factor levels that could cause rep_len issues
    alerts <- data.frame(lapply(alerts, as.character), stringsAsFactors = FALSE)
    
    # FIXED: Create column names that work with DT (no special characters)
    colnames(alerts) <- c("Alert Type", "Severity", "Message", "Time Detected")
    
    # BULLETPROOF datatable creation with error handling
    tryCatch({
      dt_result <- datatable(
        alerts, 
        options = list(
          pageLength = 5, 
          dom = 't', 
          scrollX = TRUE,
          columnDefs = list(
            list(className = 'dt-center', targets = c(1, 3))
          )
        ), 
        rownames = FALSE,
        class = "display compact"
      )
      
      # Apply styling only if datatable creation succeeded
      dt_result <- dt_result %>%
        formatStyle(
          "Severity",
          backgroundColor = styleEqual(
            c("Critical", "High", "Medium", "Warning", "Info"),
            c("#ffcdd2", "#fff3e0", "#e8f5e8", "#fff3cd", "#e3f2fd")
          ),
          color = styleEqual(
            c("Critical", "High", "Medium", "Warning", "Info"),
            c("#d32f2f", "#ef6c00", "#689f38", "#f57c00", "#1976d2")
          ),
          fontWeight = "bold"
        )
      
      return(dt_result)
      
    }, error = function(e) {
      # Ultimate fallback - return simple datatable with minimal options
      simple_alerts <- data.frame(
        Message = paste("Error creating alerts table:", e$message),
        Status = "Error",
        stringsAsFactors = FALSE
      )
      
