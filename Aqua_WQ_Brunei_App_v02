# FIXED: Bulletproof parameter extraction function
extract_param_safe <- function(param_name, station_name, default_val = NA) {
  # Comprehensive input validation
  if(missing(param_name) || is.null(param_name) || param_name == "") {
    warning(paste("Parameter name is missing or empty for station:", station_name))
    return(default_val)
  }
  
  if(missing(station_name) || is.null(station_name) || station_name == "") {
    warning(paste("Station name is missing or empty for parameter:", param_name))
    return(default_val)
  }
  
  tryCatch({
    # Check if station_df exists
    if(!exists("station_df") || is.null(station_df) || nrow(station_df) == 0) {
      warning("station_df is not available")
      return(default_val)
    }
    
    # Check if station column exists
    if(!station_name %in% colnames(station_df)) {
      warning(paste("Station", station_name, "not found in data"))
      return(default_val)
    }
    
    # Extract value with comprehensive validation
    val <- station_df %>% 
      filter(parameter == param_name) %>% 
      pull(!!sym(station_name))
    
    if(length(val) == 0) {
      warning(paste("No data found for parameter", param_name, "at station", station_name))
      return(default_val)
    }
    
    if(all(is.na(val))) {
      warning(paste("All values are NA for parameter", param_name, "at station", station_name))
      return(default_val)
    }
    
    # Get first non-NA value
    val_clean <- val[!is.na(val)]
    if(length(val_clean) == 0) {
      warning(paste("No valid values for parameter", param_name, "at station", station_name))
      return(default_val)
    }
    
    # Convert to numeric safely
    val_numeric <- suppressWarnings(as.numeric(val_clean[1]))
    
    if(is.na(val_numeric) || !is.finite(val_numeric)) {
      warning(paste("Invalid numeric value for parameter", param_name, "at station", station_name))
      return(default_val)
    }
    
    return(val_numeric)
    
  }, error = function(e) {
    warning(paste("Parameter extraction error for", param_name, "at", station_name, ":", e$message))
    return(default_val)
  })
}

