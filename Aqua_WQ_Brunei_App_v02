  monte_carlo_results <- reactive({
    # Get current parameter values from inputs
    temperature <- input$temperature %||% 28
    pH <- input$pH %||% 7.5
    dissolved_oxygen <- input$dissolved_oxygen %||% 6
    ammonia <- input$ammonia %||% 0.5
    n_simulations <- input$n_simulations %||% 1000
    
    # Validation of inputs
    if(any(c(temperature, pH, dissolved_oxygen, ammonia) < 0) || n_simulations < 100) {
      return(NULL)
    }
    
    tryCatch({
      # Set up parameter variations for Monte Carlo simulation
      temp_variation <- rnorm(n_simulations, temperature, temperature * 0.1)
      ph_variation <- rnorm(n_simulations, pH, 0.2)
      do_variation <- rnorm(n_simulations, dissolved_oxygen, dissolved_oxygen * 0.15)
      ammonia_variation <- rnorm(n_simulations, ammonia, ammonia * 0.2)
      
      # Ensure realistic parameter bounds
      temp_variation <- pmax(20, pmin(35, temp_variation))
      ph_variation <- pmax(6.0, pmin(9.0, ph_variation))
      do_variation <- pmax(0, pmin(12, do_variation))
      ammonia_variation <- pmax(0, pmin(5, ammonia_variation))
      
      # Create results data frame
      results <- data.frame(
        temperature = temp_variation,
        pH = ph_variation,
        dissolved_oxygen = do_variation,
        ammonia = ammonia_variation,
        stringsAsFactors = FALSE
      )
      
      # Calculate productivity for each simulation
      productivity_results <- sapply(1:n_simulations, function(i) {
        # Temperature factor (optimal around 28-30°C)
        temp_factor <- ifelse(results$temperature[i] >= 26 & results$temperature[i] <= 32, 
                              1.0, 
                              1.0 - abs(results$temperature[i] - 29) * 0.05)
        
        # pH factor (optimal around 7.0-8.0)
        ph_factor <- ifelse(results$pH[i] >= 6.5 & results$pH[i] <= 8.5,
                            1.0,
                            1.0 - abs(results$pH[i] - 7.5) * 0.1)
        
        # Dissolved oxygen factor (higher is better, minimum 5 mg/L)
        do_factor <- ifelse(results$dissolved_oxygen[i] >= 5,
                            min(1.0, results$dissolved_oxygen[i] / 6),
                            results$dissolved_oxygen[i] / 5 * 0.5)
        
        # Ammonia factor (lower is better, toxic above 1 mg/L)
        ammonia_factor <- ifelse(results$ammonia[i] <= 0.5,
                                 1.0,
                                 max(0.2, 1.0 - (results$ammonia[i] - 0.5) * 0.4))
        
        # Combined productivity score (0-100%)
        base_productivity <- 85 # Base productivity under optimal conditions
        final_productivity <- base_productivity * temp_factor * ph_factor * do_factor * ammonia_factor
        
        # Add some random variation
        final_productivity + rnorm(1, 0, 5)
      })
      
      # Calculate mortality risk for each simulation
      mortality_results <- sapply(1:n_simulations, function(i) {
        # Base mortality risk
        base_mortality <- 0.02
        
        # Temperature stress
        temp_stress <- ifelse(results$temperature[i] < 22 | results$temperature[i] > 34,
                              abs(results$temperature[i] - 28) * 0.002,
                              0)
        
        # pH stress
        ph_stress <- ifelse(results$pH[i] < 6.0 | results$pH[i] > 9.0,
                            abs(results$pH[i] - 7.5) * 0.01,
                            0)
        
        # Oxygen stress
        do_stress <- ifelse(results$dissolved_oxygen[i] < 4,
                            (4 - results$dissolved_oxygen[i]) * 0.02,
                            0)
        
        # Ammonia toxicity
        ammonia_stress <- ifelse(results$ammonia[i] > 1.0,
                                 (results$ammonia[i] - 1.0) * 0.05,
                                 0)
        
        # Combined mortality risk (0-1)
        total_mortality <- base_mortality + temp_stress + ph_stress + do_stress + ammonia_stress
        
        # Cap at reasonable maximum
        min(0.5, max(0.001, total_mortality))
      })
      
      # Calculate summary statistics for productivity
      productivity_stats <- list(
        mean = mean(productivity_results, na.rm = TRUE),
        sd = sd(productivity_results, na.rm = TRUE),
        quantiles = quantile(productivity_results, probs = c(0.05, 0.25, 0.5, 0.75, 0.95), na.rm = TRUE)
      )
      
      # Calculate summary statistics for mortality
      mortality_stats <- list(
        mean = mean(mortality_results, na.rm = TRUE),
        sd = sd(mortality_results, na.rm = TRUE),
        quantiles = quantile(mortality_results, probs = c(0.05, 0.25, 0.5, 0.75, 0.95), na.rm = TRUE)
      )
      
      # Safely calculate proportions
      safe_proportion <- function(logical_vector) {
        if(length(logical_vector) == 0) return(0)
        valid_logical <- logical_vector[!is.na(logical_vector)]
        if(length(valid_logical) == 0) return(0)
        sum(valid_logical) / length(valid_logical)
      }
      
      # Risk metrics calculation with safe operations
      risk_metrics <- list(
        productivity_below_target = safe_proportion(productivity_results < 70),
        mortality_above_critical = safe_proportion(mortality_results > 0.05),
        overall_success_probability = safe_proportion(
          productivity_results >= 70 & mortality_results <= 0.05
        )
      )
      
      # Return comprehensive results
      return(list(
        productivity = productivity_stats,
        mortality = mortality_stats,
        risk_metrics = risk_metrics,
        simulation_data = list(
          productivity = productivity_results,
          mortality = mortality_results,
          parameters = results
        )
      ))
      
    }, error = function(e) {
      # Ultimate error fallback with safe default values
      warning("Monte Carlo simulation encountered error: ", e$message)
      
      # Create safe default vectors using standard R functions only
      default_prod <- rep(75, 100)
      default_mort <- rep(0.03, 100)
      
      return(list(
        productivity = list(
          mean = 75,
          sd = 15,
          quantiles = setNames(c(45, 65, 75, 85, 105), c("5%", "25%", "50%", "75%", "95%"))
