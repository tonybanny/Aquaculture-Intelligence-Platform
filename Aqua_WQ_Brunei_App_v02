        group_by(parameter) %>%
        mutate(
          z_score = if(sd(mean_value, na.rm = TRUE) > 0) {
            (mean_value - mean(mean_value, na.rm = TRUE)) / sd(mean_value, na.rm = TRUE)
          } else {
            0
          }
