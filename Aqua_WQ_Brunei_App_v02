  # Calculate stress index function
  calculate_stress_index <- function(value, stress_params, inverse = FALSE) {
    if (inverse) {
      # For parameters where higher values are better (like DO)
      stress <- pmax(0, (stress_params$optimal - value) / stress_params$optimal)
    } else {
      # For parameters where values outside optimal range cause stress
      optimal_range <- stress_params$optimal
      if (is.list(optimal_range)) {
        # Range-based optimal values
        if (value < optimal_range$min) {
          stress <- (optimal_range$min - value) / optimal_range$min
        } else if (value > optimal_range$max) {
          stress <- (value - optimal_range$max) / optimal_range$max
        } else {
          stress <- 0
        }
      } else {
        # Single optimal value
        stress <- abs(value - optimal_range) / optimal_range
      }
    }
    return(pmin(1, pmax(0, stress)))
    
    
    # Define simulation parameters (should be available globally)
    simulation_params <- list(
      productivity_base = 100,
      mortality_base = 0.02,
      morbidity_base = 0.1,
      temperature_stress = list(optimal = list(min = 26, max = 30)),
      ph_stress = list(optimal = list(min = 7.0, max = 8.0)),
      do_stress = list(optimal = 6),
      ammonia_stress = list(optimal = 0),
      culture_types = list(
        Tilapia = list(mortality_base = 0.02),
        Catfish = list(mortality_base = 0.025),
        Carp = list(mortality_base = 0.015)
      )
    )
  }  
  
  
  
  # ============================================================================
  # ENHANCED PREDICTION FUNCTION WITH UNCERTAINTY QUANTIFICATION
  # ============================================================================
  
  predict_with_uncertainty <- function(water_params, models_list, 
                                       culture_type = "Tilapia",
                                       stocking_density = 100,
                                       feed_quality = 0.9,
                                       season = "Dry") {
    
    tryCatch({
      # Prepare input features
      input_data <- data.frame(
        temperature = water_params$temperature,
        pH = water_params$pH,
        dissolved_oxygen = water_params$dissolved_oxygen,
        ammonia = water_params$ammonia,
        nitrate = water_params$nitrate %||% 2,
        phosphate = water_params$phosphate %||% 0.3,
        turbidity = water_params$turbidity %||% 12,
        alkalinity = water_params$alkalinity %||% 100,
        stocking_density = stocking_density,
        feed_quality = feed_quality,
        culture_type_num = as.numeric(as.factor(culture_type)),
        season_num = as.numeric(as.factor(season))
      )
      
      # Calculate stress indices
      input_data$temp_stress <- pmax(0, pmin(1, abs(input_data$temperature - 28) / 10))
      # Calculate stress indices (continuation)
      input_data$ph_stress <- pmax(0, pmin(1, abs(input_data$pH - 7.5) / 2))
      input_data$do_stress <- pmax(0, pmin(1, (5 - input_data$dissolved_oxygen) / 5))
      input_data$ammonia_stress <- pmax(0, pmin(1, input_data$ammonia / 0.1))
      
      input_data$combined_stress <- (input_data$temp_stress + input_data$ph_stress + 
                                       input_data$do_stress + input_data$ammonia_stress) / 4
      
      # Extract models
      models <- models_list$models
      feature_cols <- models_list$feature_cols
      
      # Ensure all required features exist
      missing_features <- setdiff(feature_cols, names(input_data))
      if(length(missing_features) > 0) {
        for(feat in missing_features) {
          input_data[[feat]] <- 0
        }
      }
      
      # Select only required features in correct order
      pred_features <- input_data[, feature_cols]
      
      # ENSEMBLE PREDICTIONS with uncertainty quantification
      
      # Random Forest predictions with prediction intervals
      rf_prod <- predict(models$rf_productivity, pred_features)
      rf_mort <- predict(models$rf_mortality, pred_features)
      rf_morb <- predict(models$rf_morbidity, pred_features)
      
      # Get RF prediction intervals using all trees
      rf_prod_all <- predict(models$rf_productivity, pred_features, predict.all = TRUE)$individual
      rf_prod_lower <- apply(rf_prod_all, 1, quantile, 0.025)
      rf_prod_upper <- apply(rf_prod_all, 1, quantile, 0.975)
      
      # Gradient Boosting predictions
      gbm_prod <- predict(models$gbm_productivity, pred_features, n.trees = 2000, type = "response")
      gbm_mort <- predict(models$gbm_mortality, pred_features, n.trees = 2000, type = "response")
      
      # SVM predictions (need to scale features)
      pred_features_scaled <- scale(pred_features, 
                                    center = models$scaling_params$center,
                                    scale = models$scaling_params$scale)
      svm_prod <- predict(models$svm_productivity, pred_features_scaled)
      svm_mort <- predict(models$svm_mortality, pred_features_scaled)
      
      # ENSEMBLE AGGREGATION using optimized weights
      weights <- models$ensemble_weights
      
      final_productivity <- weights["rf"] * rf_prod + 
        weights["gbm"] * gbm_prod + 
        weights["svm"] * svm_prod
      
      final_mortality <- weights["rf"] * rf_mort + 
        weights["gbm"] * gbm_mort + 
        weights["svm"] * svm_mort
      
      final_morbidity <- rf_morb  # Single model for morbidity
      
      # UNCERTAINTY QUANTIFICATION
      # Calculate prediction variance from ensemble
      all_prod_preds <- c(rf_prod, gbm_prod, svm_prod)
      pred_variance <- var(all_prod_preds)
      pred_std <- sqrt(pred_variance)
      
      # Confidence intervals
      ci_lower <- final_productivity - 1.96 * pred_std
      ci_upper <- final_productivity + 1.96 * pred_std
      
      # RISK ASSESSMENT
      risk_factors <- list(
        temperature_risk = input_data$temp_stress,
        ph_risk = input_data$ph_stress,
        oxygen_risk = input_data$do_stress,
        ammonia_risk = input_data$ammonia_stress,
        overall_risk = input_data$combined_stress,
        risk_level = case_when(
          input_data$combined_stress < 0.3 ~ "Low",
          input_data$combined_stress < 0.6 ~ "Medium",
          TRUE ~ "High"
        )
      )
      
      # ECONOMIC IMPACT CALCULATION
      baseline_productivity <- 100  # kg/ha/day
      productivity_loss <- pmax(0, baseline_productivity - final_productivity)
      
      # Economic parameters
      price_per_kg <- 5  # USD
      area_ha <- 1  # per hectare
      
      economic_loss <- productivity_loss * price_per_kg * area_ha
      potential_revenue <- final_productivity * price_per_kg * area_ha
      
      # Calculate ROI of optimization
      optimization_cost <- 50  # USD/day
      optimization_benefit <- economic_loss * 0.7  # 70% recovery potential
      roi <- (optimization_benefit - optimization_cost) / optimization_cost * 100
      
      # FEATURE IMPORTANCE from Random Forest
      importance_scores <- importance(models$rf_productivity)
      top_features <- head(sort(importance_scores[, 1], decreasing = TRUE), 5)
      
      # PREDICTION QUALITY METRICS
      prediction_confidence <- 1 - (pred_std / mean(all_prod_preds))
      model_agreement <- 1 - (sd(all_prod_preds) / mean(all_prod_preds))
      
      # RETURN COMPREHENSIVE RESULTS
      return(list(
        predictions = list(
          productivity = as.numeric(final_productivity),
          mortality = as.numeric(final_mortality),
          morbidity = as.numeric(final_morbidity),
          productivity_ci_lower = as.numeric(ci_lower),
          productivity_ci_upper = as.numeric(ci_upper)
        ),
        
        uncertainty = list(
          prediction_std = as.numeric(pred_std),
          confidence_level = as.numeric(prediction_confidence),
          model_agreement = as.numeric(model_agreement),
          ensemble_variance = as.numeric(pred_variance)
        ),
        
        risk_assessment = risk_factors,
        
        economic_impact = list(
          productivity_loss_kg = as.numeric(productivity_loss),
          economic_loss_usd = as.numeric(economic_loss),
          potential_revenue_usd = as.numeric(potential_revenue),
          optimization_roi_pct = as.numeric(roi)
        ),
        
        feature_importance = as.list(top_features),
        
        water_quality_score = as.numeric(100 * (1 - input_data$combined_stress)),
        
        recommendations = generate_recommendations(input_data, risk_factors),
        
        metadata = list(
          culture_type = culture_type,
          stocking_density = stocking_density,
          feed_quality = feed_quality,
          season = season,
          prediction_timestamp = Sys.time()
        )
      ))
      
    }, error = function(e) {
      # Error handling with informative fallback
      warning(paste("Prediction error:", e$message))
      
      return(list(
        predictions = list(
          productivity = 75,
          mortality = 0.03,
          morbidity = 0.05,
          productivity_ci_lower = 60,
          productivity_ci_upper = 90
        ),
        uncertainty = list(
          prediction_std = 10,
          confidence_level = 0.5,
          model_agreement = 0.5,
          ensemble_variance = 100
        ),
        risk_assessment = list(
          overall_risk = 0.5,
          risk_level = "Medium"
        ),
        economic_impact = list(
          productivity_loss_kg = 25,
          economic_loss_usd = 125,
          potential_revenue_usd = 375,
          optimization_roi_pct = 50
        ),
        error = e$message
      ))
    })
  }
  
