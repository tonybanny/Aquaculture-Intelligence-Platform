  # Simulate productivity based on conditions
  simulate_productivity <- function(data) {
    base_productivity <- simulation_params$productivity_base
    
    productivity <- base_productivity * (1 - data$combined_stress * 0.7) * 
      data$feed_quality * 
      ifelse(data$season == "Wet", 0.9, 1.1) *
      (1 - (data$stocking_density - 100) / 500) * # Density effect
      runif(nrow(data), 0.8, 1.2) # Random variation
    
    return(pmax(10, productivity)) # Minimum 10 kg/ha/day
  }
  
  # Simulate mortality based on conditions
  simulate_mortality <- function(data) {
    culture_mortality <- sapply(data$culture_type, function(ct) {
      simulation_params$culture_types[[ct]]$mortality_base
    })
    
    mortality <- culture_mortality * (1 + data$combined_stress * 5) *
      ifelse(data$season == "Wet", 1.2, 0.8) *
      (1 + (data$stocking_density - 100) / 1000) * # Density stress
      runif(nrow(data), 0.7, 1.3) # Random variation
    
    return(pmax(0.001, pmin(0.2, mortality))) # Cap between 0.1% and 20%
  }
  
  # Simulate morbidity based on conditions
  simulate_morbidity <- function(data) {
    base_morbidity <- simulation_params$morbidity_base
    
    morbidity <- base_morbidity * (1 + data$combined_stress * 3) *
      ifelse(data$season == "Wet", 1.3, 0.9) *
      (1 + (data$stocking_density - 125) / 800) *
      runif(nrow(data), 0.8, 1.2)
    
    return(pmax(0.005, pmin(0.4, morbidity))) # Cap between 0.5% and 40%
  }
  
  
  
  
