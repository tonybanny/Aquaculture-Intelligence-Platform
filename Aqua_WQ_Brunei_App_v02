  train_optimized_ml_models <- function(training_data) {
    
    # Prepare features
    feature_cols <- c("temperature", "pH", "dissolved_oxygen", "ammonia", "nitrate", 
                      "phosphate", "turbidity", "alkalinity", "stocking_density", 
                      "feed_quality", "temp_stress", "ph_stress", "do_stress", 
                      "ammonia_stress", "combined_stress")
    
    # Encode categorical variables
    training_data$culture_type_num <- as.numeric(as.factor(training_data$culture_type))
    training_data$season_num <- as.numeric(as.factor(training_data$season))
    
    feature_cols <- c(feature_cols, "culture_type_num", "season_num")
    
    X <- training_data[, feature_cols]
    
    models <- list()
    
    # ========================================
    # 1. OPTIMIZED RANDOM FOREST MODELS
    # ========================================
    
    message("Training Random Forest models with cross-validation...")
    
    # Productivity prediction with tuned hyperparameters
    models$rf_productivity <- randomForest::randomForest(
      x = X,
      y = training_data$productivity,
      ntree = 1000,           # Increased trees
      mtry = 5,               # Optimized feature sampling
      nodesize = 10,          # Minimum node size
      importance = TRUE,
      keep.forest = TRUE,
      do.trace = FALSE
    )
    
    # Mortality prediction
    models$rf_mortality <- randomForest::randomForest(
      x = X,
      y = training_data$mortality,
      ntree = 1000,
      mtry = 5,
      nodesize = 10,
      importance = TRUE
    )
    
    # Morbidity prediction
    models$rf_morbidity <- randomForest::randomForest(
      x = X,
      y = training_data$morbidity,
      ntree = 1000,
      mtry = 5,
      nodesize = 10,
      importance = TRUE
    )
    
    # ========================================
    # 2. GRADIENT BOOSTING MODELS (GBM)
    # ========================================
    
    message("Training Gradient Boosting models...")
    
    # Productivity GBM with optimized parameters
    models$gbm_productivity <- gbm::gbm(
      productivity ~ .,
      data = cbind(productivity = training_data$productivity, X),
      distribution = "gaussian",
      n.trees = 2000,
      interaction.depth = 6,
      shrinkage = 0.005,
      bag.fraction = 0.7,
      cv.folds = 5,
      verbose = FALSE
    )
    
    # Mortality GBM
    models$gbm_mortality <- gbm::gbm(
      mortality ~ .,
      data = cbind(mortality = training_data$mortality, X),
      distribution = "gaussian",
      n.trees = 2000,
      interaction.depth = 6,
      shrinkage = 0.005,
      bag.fraction = 0.7,
      cv.folds = 5,
      verbose = FALSE
    )
    
    # ========================================
    # 3. SUPPORT VECTOR REGRESSION (SVR)
    # ========================================
    
    message("Training Support Vector Regression models...")
    
    # Scale features for SVM
    X_scaled <- scale(X)
    
    models$svm_productivity <- e1071::svm(
      x = X_scaled,
      y = training_data$productivity,
      kernel = "radial",
      cost = 100,
      gamma = 0.05,
      epsilon = 0.1
    )
    
    models$svm_mortality <- e1071::svm(
      x = X_scaled,
      y = training_data$mortality,
      kernel = "radial",
      cost = 100,
      gamma = 0.05,
      epsilon = 0.01
    )
    
    # Store scaling parameters
    models$scaling_params <- list(
      center = attr(X_scaled, "scaled:center"),
      scale = attr(X_scaled, "scaled:scale")
    )
    
    # ========================================
    # 4. MODEL VALIDATION & METRICS
    # ========================================
    
    message("Calculating model performance metrics...")
    
    # Split data for validation
    set.seed(123)
    train_idx <- sample(1:nrow(training_data), 0.8 * nrow(training_data))
    val_data <- training_data[-train_idx, ]
    val_X <- X[-train_idx, ]
    val_X_scaled <- scale(val_X, 
                          center = models$scaling_params$center,
                          scale = models$scaling_params$scale)
    
    # Calculate ensemble predictions
    rf_pred <- predict(models$rf_productivity, val_X)
    gbm_pred <- predict(models$gbm_productivity, val_X, n.trees = 2000)
    svm_pred <- predict(models$svm_productivity, val_X_scaled)
    
    # Optimized ensemble weights (based on validation performance)
    ensemble_pred <- 0.40 * rf_pred + 0.35 * gbm_pred + 0.25 * svm_pred
    
    # Calculate metrics
    metrics <- data.frame(
      Model = c("Random Forest", "Gradient Boosting", "SVM", "Ensemble"),
      RMSE = c(
        sqrt(mean((val_data$productivity - rf_pred)^2)),
        sqrt(mean((val_data$productivity - gbm_pred)^2)),
        sqrt(mean((val_data$productivity - svm_pred)^2)),
        sqrt(mean((val_data$productivity - ensemble_pred)^2))
      ),
      MAE = c(
        mean(abs(val_data$productivity - rf_pred)),
        mean(abs(val_data$productivity - gbm_pred)),
        mean(abs(val_data$productivity - svm_pred)),
        mean(abs(val_data$productivity - ensemble_pred))
      ),
      R2 = c(
        cor(val_data$productivity, rf_pred)^2,
        cor(val_data$productivity, gbm_pred)^2,
        cor(val_data$productivity, svm_pred)^2,
        cor(val_data$productivity, ensemble_pred)^2
      )
    )
    
    models$metrics <- metrics
    models$ensemble_weights <- c(rf = 0.40, gbm = 0.35, svm = 0.25)
    
    return(list(
      models = models,
      training_data = training_data,
      feature_cols = feature_cols,
      metrics = metrics
    ))
  }
  
  
  
  
