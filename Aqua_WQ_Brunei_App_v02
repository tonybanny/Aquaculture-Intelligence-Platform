      if("price_per_tonne" %in% names(mapping) && mapping$price_per_tonne %in% names(df)) {
        price_col <- df[[mapping$price_per_tonne]]
        std_df$price_per_tonne <- as.numeric(gsub("[^0-9.]", "", as.character(price_col)))
        std_df$price_per_tonne[is.na(std_df$price_per_tonne)] <- 0
      } else {
        std_df$price_per_tonne <- rep(0, n_rows)
      }
      
      if("year" %in% names(mapping) && mapping$year %in% names(df)) {
        year_col <- df[[mapping$year]]
        # Handle different year formats
        if(is.character(year_col) || is.factor(year_col)) {
          year_extracted <- as.numeric(gsub("[^0-9]", "", as.character(year_col)))
          # If year seems to be in date format, extract year
          date_years <- suppressWarnings({
            as.numeric(format(as.Date(as.character(year_col), 
                                      tryFormats = c("%Y-%m-%d", "%d/%m/%Y", "%m/%d/%Y")), "%Y"))
          })
          year_extracted <- ifelse(!is.na(date_years), date_years, year_extracted)
          std_df$year <- ifelse(is.na(year_extracted) | year_extracted < 1900 | year_extracted > 2100, 
                                as.numeric(format(Sys.Date(), "%Y")), year_extracted)
        } else {
          std_df$year <- as.numeric(year_col)
          std_df$year[is.na(std_df$year)] <- as.numeric(format(Sys.Date(), "%Y"))
        }
      } else {
        std_df$year <- rep(as.numeric(format(Sys.Date(), "%Y")), n_rows)
      }
      
      # Handle revenue column if it exists, otherwise calculate
      if("revenue" %in% names(mapping) && mapping$revenue %in% names(df)) {
        rev_col <- df[[mapping$revenue]]
        std_df$revenue <- as.numeric(gsub("[^0-9.]", "", as.character(rev_col)))
        std_df$revenue[is.na(std_df$revenue)] <- 0
      } else {
        std_df$revenue <- std_df$production_tonnes * std_df$price_per_tonne
      }
      
      # Clean and validate data
      std_df <- std_df %>%
        filter(!is.na(station), station != "", station != "NA") %>%
        mutate(
          production_tonnes = ifelse(is.na(production_tonnes) | production_tonnes < 0, 0, production_tonnes),
          price_per_tonne = ifelse(is.na(price_per_tonne) | price_per_tonne < 0, 0, price_per_tonne),
          year = ifelse(is.na(year) | year < 1900 | year > 2100, 
                        as.numeric(format(Sys.Date(), "%Y")), year),
          revenue = ifelse(is.na(revenue) | revenue < 0, 
                           production_tonnes * price_per_tonne, revenue)
        ) %>%
        distinct() # Remove duplicates
      
      return(std_df)
      
    }, error = function(e) {
      showNotification(paste("Data standardization error:", e$message), type = "error", duration = 10)
      return(data.frame(
        station = character(0),
        production_tonnes = numeric(0),
        price_per_tonne = numeric(0),
        year = numeric(0),
        revenue = numeric(0),
        stringsAsFactors = FALSE
      ))
    })
  }
  
  
