# 2. ADVANCED COLUMN DETECTION FUNCTION
detect_column_types <- function(df) {
  col_names_lower <- tolower(names(df))
  
  # Define flexible pattern matching for different vocabularies
  patterns <- list(
    station = c("station", "site", "location", "place", "name", "id", "code", 
                "facility", "farm", "point", "sample"),
    parameter = c("parameter", "variable", "measure", "metric", "indicator", 
                  "test", "analyte", "component"),
    value = c("value", "reading", "result", "measurement", "concentration", 
              "level", "amount"),
    date = c("date", "time", "timestamp", "datetime", "period", "year", 
             "month", "day"),
    unit = c("unit", "units", "measurement", "uom"),
    lat = c("lat", "latitude", "y", "northing"),
    lon = c("lon", "long", "longitude", "x", "easting")
  )
  
  detected <- list()
  
  for (col_type in names(patterns)) {
    matches <- sapply(patterns[[col_type]], function(pattern) {
      grep(pattern, col_names_lower, value = TRUE)
    })
    matches <- unlist(matches)
    
    if (length(matches) > 0) {
      # Return original column name (not lowercased)
      detected[[col_type]] <- names(df)[col_names_lower == matches[1]]
    }
  }
  
  return(detected)
}

# 3. INTELLIGENT DATA STRUCTURE DETECTION
detect_data_format <- function(df) {
  n_cols <- ncol(df)
  n_rows <- nrow(df)
  
  # Detect if data is in wide or long format
  numeric_cols <- sum(sapply(df, is.numeric))
  
  format_type <- if (numeric_cols > n_cols * 0.5) {
    "wide"  # Multiple numeric columns (stations as columns)
  } else if (n_cols <= 4) {
    "long"  # Few columns (parameter, station, value format)
  } else {
    "mixed"
  }
  
  return(list(
    format = format_type,
    n_rows = n_rows,
    n_cols = n_cols,
    numeric_cols = numeric_cols
  ))
}

# 4. FLEXIBLE DATA TRANSFORMER
transform_user_data <- function(df, mapping, format_type) {
  tryCatch({
    if (format_type == "long") {
      # Transform long to wide format
      required_cols <- c(mapping$parameter, mapping$station, mapping$value)
      
      if (all(required_cols %in% names(df))) {
        wide_data <- df %>%
          select(!!!syms(required_cols)) %>%
          pivot_wider(
            names_from = !!sym(mapping$station),
            values_from = !!sym(mapping$value),
            id_cols = !!sym(mapping$parameter)
          ) %>%
          mutate(index = row_number()) %>%
          rename(parameter = !!sym(mapping$parameter))
        
        return(wide_data)
      }
    } else if (format_type == "wide") {
      # Data is already in wide format
      if (!is.null(mapping$parameter) && mapping$parameter %in% names(df)) {
        df <- df %>%
          mutate(index = row_number()) %>%
          rename(parameter = !!sym(mapping$parameter))
      } else {
        df$index <- 1:nrow(df)
        df$parameter <- paste0("Parameter_", 1:nrow(df))
      }
      
      return(df)
    }
    
    return(NULL)
    
  }, error = function(e) {
    message("Data transformation error: ", e$message)
    return(NULL)
  })
}


