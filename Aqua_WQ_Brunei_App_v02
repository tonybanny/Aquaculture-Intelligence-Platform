  # Enhanced column name detection function
  detect_column_mapping <- function(df) {
    col_names <- tolower(names(df))
    
    # Define possible column name variations
    station_patterns <- c("station", "site", "location", "farm", "facility", "id", "station_id", "site_id")
    production_patterns <- c("production", "yield", "harvest", "output", "tonnes", "tons", "kg", "production_tonnes", "total_production")
    price_patterns <- c("price", "cost", "rate", "value", "price_per", "unit_price", "price_per_tonne", "price_per_kg")
    year_patterns <- c("year", "date", "period", "time", "season", "cycle")
    revenue_patterns <- c("revenue", "income", "earnings", "sales", "total_revenue", "gross_revenue")
    
    mapping <- list()
    
    # Find station column
    station_match <- col_names[sapply(station_patterns, function(p) any(grepl(p, col_names)))]
    if(length(station_match) > 0) {
      mapping$station <- names(df)[which(col_names == station_match[1])]
    }
    
    # Find production column
    production_match <- col_names[sapply(production_patterns, function(p) any(grepl(p, col_names)))]
    if(length(production_match) > 0) {
      mapping$production_tonnes <- names(df)[which(col_names == production_match[1])]
    }
    
    # Find price column
    price_match <- col_names[sapply(price_patterns, function(p) any(grepl(p, col_names)))]
    if(length(price_match) > 0) {
      mapping$price_per_tonne <- names(df)[which(col_names == price_match[1])]
    }
    
    # Find year column
    year_match <- col_names[sapply(year_patterns, function(p) any(grepl(p, col_names)))]
    if(length(year_match) > 0) {
      mapping$year <- names(df)[which(col_names == year_match[1])]
    }
    
    # Find revenue column (optional)
    revenue_match <- col_names[sapply(revenue_patterns, function(p) any(grepl(p, col_names)))]
    if(length(revenue_match) > 0) {
      mapping$revenue <- names(df)[which(col_names == revenue_match[1])]
    }
    
    return(mapping)
  }
  
  # Enhanced data validation and standardization
  standardize_se_data <- function(df, mapping) {
    tryCatch({
      # Check if input dataframe is empty or NULL
      if(is.null(df) || nrow(df) == 0) {
        return(data.frame(
          station = character(0),
          production_tonnes = numeric(0),
          price_per_tonne = numeric(0),
          year = numeric(0),
          revenue = numeric(0),
          stringsAsFactors = FALSE
        ))
      }
      
      # Initialize vectors with the correct length
      n_rows <- nrow(df)
      
      # Create standardized vectors
      station_vec <- character(n_rows)
      production_vec <- numeric(n_rows)
      price_vec <- numeric(n_rows)
      year_vec <- numeric(n_rows)
      revenue_vec <- numeric(n_rows)
      
      # Map columns if they exist
      if("station" %in% names(mapping) && mapping$station %in% names(df)) {
        station_vec <- as.character(df[[mapping$station]])
      } else {
        station_vec <- paste0("Station_", 1:n_rows)
      }
      
      if("production_tonnes" %in% names(mapping) && mapping$production_tonnes %in% names(df)) {
        prod_col <- df[[mapping$production_tonnes]]
        production_vec <- as.numeric(gsub("[^0-9.]", "", as.character(prod_col)))
        production_vec[is.na(production_vec)] <- 0
      } else {
        production_vec <- rep(0, n_rows)
      }
      
      if("price_per_tonne" %in% names(mapping) && mapping$price_per_tonne %in% names(df)) {
        price_col <- df[[mapping$price_per_tonne]]
        price_vec <- as.numeric(gsub("[^0-9.]", "", as.character(price_col)))
        price_vec[is.na(price_vec)] <- 0
      } else {
        price_vec <- rep(0, n_rows)
      }
      
      if("year" %in% names(mapping) && mapping$year %in% names(df)) {
        year_col <- df[[mapping$year]]
        # Handle different year formats
        if(is.character(year_col) || is.factor(year_col)) {
          year_extracted <- as.numeric(gsub("[^0-9]", "", as.character(year_col)))
          # If year seems to be in date format, extract year
          if(any(nchar(as.character(year_col)) > 4, na.rm = TRUE)) {
            year_extracted <- as.numeric(format(as.Date(as.character(year_col), tryFormats = c("%Y-%m-%d", "%d/%m/%Y", "%m/%d/%Y")), "%Y"))
          }
          year_vec <- ifelse(is.na(year_extracted) | year_extracted < 1900 | year_extracted > 2100, 
                             as.numeric(format(Sys.Date(), "%Y")), year_extracted)
        } else {
          year_vec <- as.numeric(year_col)
          year_vec[is.na(year_vec)] <- as.numeric(format(Sys.Date(), "%Y"))
        }
      } else {
        year_vec <- rep(as.numeric(format(Sys.Date(), "%Y")), n_rows)
      }
      
      # Handle revenue column if it exists, otherwise calculate
      if("revenue" %in% names(mapping) && mapping$revenue %in% names(df)) {
        rev_col <- df[[mapping$revenue]]
        revenue_vec <- as.numeric(gsub("[^0-9.]", "", as.character(rev_col)))
        revenue_vec[is.na(revenue_vec)] <- 0
      } else {
        revenue_vec <- production_vec * price_vec
      }
      
      # Create the standardized dataframe
      std_df <- data.frame(
        station = station_vec,
        production_tonnes = production_vec,
        price_per_tonne = price_vec,
        year = year_vec,
        revenue = revenue_vec,
        stringsAsFactors = FALSE
      )
      
      # Clean and validate data
      std_df <- std_df %>%
        filter(!is.na(station), station != "") %>%
        mutate(
          production_tonnes = ifelse(is.na(production_tonnes) | production_tonnes < 0, 0, production_tonnes),
          price_per_tonne = ifelse(is.na(price_per_tonne) | price_per_tonne < 0, 0, price_per_tonne),
          year = ifelse(is.na(year) | year < 1900 | year > 2100, 
                        as.numeric(format(Sys.Date(), "%Y")), year),
          revenue = ifelse(is.na(revenue) | revenue < 0, 
                           production_tonnes * price_per_tonne, revenue)
        ) %>%
        distinct() # Remove duplicates
      
      return(std_df)
      
    }, error = function(e) {
      showNotification(paste("Data standardization error:", e$message), type = "error", duration = 10)
      return(data.frame(
        station = character(0),
        production_tonnes = numeric(0),
        price_per_tonne = numeric(0),
        year = numeric(0),
        revenue = numeric(0),
        stringsAsFactors = FALSE
      ))
    })
  }
  
  
