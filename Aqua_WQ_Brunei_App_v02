# --- Utility functions: long format conversion, compare with thresholds, scoring
to_long <- function(df){
  df %>% gather(key="station", value="value", -index, -parameter) %>% mutate(value = as.numeric(value))
}

long_df <- to_long(station_df)

compare_with_thresholds <- function(long_df, thr_tbl){
  # thr_tbl: tibble(parameter, min, max)
  df <- left_join(long_df, thr_tbl, by="parameter")
  df <- df %>% mutate(
    within = case_when(
      !is.na(min) & !is.na(max) ~ value >= min & value <= max,
      !is.na(min) & is.na(max) ~ value >= min,
      is.na(min) & !is.na(max) ~ value <= max,
      TRUE ~ NA
    )
  )
  df
}

compute_weighted_score <- function(compare_df, weights){
  # weights: named numeric vector for parameter weights (names = parameter)
  df <- compare_df %>% mutate(weight = weights[parameter] %||% 1)
  score_tbl <- df %>%
    group_by(station) %>%
    summarise(total_weight = sum(weight[!is.na(within)]),
              weight_ok = sum(weight[within==TRUE], na.rm=TRUE),
              score = ifelse(total_weight>0, 100 * weight_ok / total_weight, NA)) %>%
    arrange(desc(score))
  score_tbl
}

