    # Fixed Monte Carlo simulation with NO rep_len usage
    n_sims <- 1000L
    
    # Generate distributions using only standard R functions
    create_safe_distribution <- function(mean_val, sd_val, n) {
      dist <- rnorm(n, mean = mean_val, sd = sd_val)
      # Remove any non-finite values and replace with mean
      dist[!is.finite(dist)] <- mean_val
      return(dist)
    }
    
    temp_dist <- create_safe_distribution(temp_base, 1.5, n_sims)
    ph_dist <- create_safe_distribution(ph_base, 0.3, n_sims)
    do_dist <- create_safe_distribution(do_base, 0.8, n_sims)
    ammonia_dist <- abs(create_safe_distribution(ammonia_base, 0.02, n_sims))
    
    # Ensure all distributions are exactly n_sims length
    validate_length <- function(dist, target_length, default_val) {
      if(length(dist) != target_length) {
        return(rep(default_val, target_length))
      }
      return(dist)
    }
    
    temp_dist <- validate_length(temp_dist, n_sims, temp_base)
    ph_dist <- validate_length(ph_dist, n_sims, ph_base)
    do_dist <- validate_length(do_dist, n_sims, do_base)
